# =============================================================================
# API versions
# =============================================================================
# Primary api-version used for every call.
API_VERSION=2025-11-01

# Second api-version probed during --mode project-scoped verify only.
# Lets the harness demonstrate whether get-by-id succeeds on one api-version
# but not the other. Ignored in --mode account.
PREVIEW_API_VERSION=2026-06-01-preview

# =============================================================================
# Source Foundry resource (where the analyzer originates)
# =============================================================================
SOURCE_ENDPOINT=https://<source-resource-name>.services.ai.azure.com
SOURCE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<source-resource-name>
SOURCE_REGION=<azure-region>         # e.g. eastus2
SOURCE_AUTH_MODE=entra               # entra | key
SOURCE_KEY=

# =============================================================================
# Target Foundry resource (where the analyzer is copied to)
# =============================================================================
TARGET_ENDPOINT=https://<target-resource-name>.services.ai.azure.com
TARGET_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<target-resource-name>
TARGET_REGION=<azure-region>         # e.g. eastus2
TARGET_AUTH_MODE=entra               # entra | key
# Even when TARGET_AUTH_MODE=entra, setting TARGET_KEY unlocks an extra
# entra-vs-key comparison row in the verify matrix (target only).
TARGET_KEY=

# =============================================================================
# Analyzer body overrides (both modes)
# =============================================================================
# Optional: override the completion / embedding models the harness PUTs when
# creating analyzers. These must be deployed on BOTH resources or analyzer
# creation will fail. Defaults live in repro.py::_analyzer_body().
COMPLETION_MODEL=
EMBEDDING_MODEL=

# Prefix for analyzer IDs the harness creates in --mode account. A UTC
# timestamp is appended per run. Ignored for the source analyzer in
# --mode project-scoped (that id comes from SOURCE_ANALYZER_ID below).
ANALYZER_BASE_NAME=cu_copy_repro

# =============================================================================
# Project-scoped mode (--mode project-scoped)
# =============================================================================
# Populate these ONLY when you plan to run with --mode project-scoped. In
# that mode the harness does NOT create the source analyzer — it reuses an
# existing portal-created (project-scoped) analyzer that already lives on
# SOURCE, then copies it to TARGET and probes get-by-id under both
# API_VERSION and PREVIEW_API_VERSION.
#
# SOURCE_ANALYZER_ID: analyzer id as shown in the source's GET /analyzers
# list. Example: LSC_LP_Test1
SOURCE_ANALYZER_ID=
#
# SOURCE_PROJECT_ID: optional, informational only. Surfaced in report.md so
# reviewers can cross-reference the portal project. The actual project
# scoping is determined by the analyzer's own tags on the source resource,
# which the harness reads and reports separately.
# Example: 8caea153-340b-4da1-b6de-a034a47364d6
SOURCE_PROJECT_ID=
