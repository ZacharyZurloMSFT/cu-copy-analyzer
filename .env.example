# =============================================================================
# API versions
# =============================================================================
# Primary api-version used for every call, including the copy operation.
API_VERSION=2025-11-01

# Second api-version probed only during verify. Lets the harness demonstrate
# whether get-by-id succeeds on one api-version but not the other for
# project-scoped copied analyzers.
PREVIEW_API_VERSION=2026-06-01-preview

# =============================================================================
# Source Foundry resource (where the portal-created analyzer already lives)
# =============================================================================
SOURCE_ENDPOINT=https://<source-resource-name>.services.ai.azure.com
SOURCE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<source-resource-name>
SOURCE_REGION=<azure-region>         # e.g. eastus2
SOURCE_AUTH_MODE=entra               # entra | key
SOURCE_KEY=

# REQUIRED: id of an existing portal-created (project-scoped) analyzer on the
# source resource. The harness will NOT create this analyzer — it only GETs
# it to confirm it is ready, then copies it to TARGET.
# Example: COQAnalyzerV1
SOURCE_ANALYZER_ID=

# Optional, informational only. Surfaced in report.md so reviewers can
# cross-reference the portal project. The actual project scoping is
# determined by the analyzer's own tags, which the harness reads from source
# and reports separately.
# Example: 0c974c65-34e4-4432-a23f-c34392105c3b
SOURCE_PROJECT_ID=

# =============================================================================
# Target Foundry resource (where the analyzer is copied to)
# =============================================================================
TARGET_ENDPOINT=https://<target-resource-name>.services.ai.azure.com
TARGET_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<target-resource-name>
TARGET_REGION=<azure-region>         # e.g. eastus2
TARGET_AUTH_MODE=entra               # entra | key
# Even when TARGET_AUTH_MODE=entra, setting TARGET_KEY adds an extra
# entra-vs-key comparison row for the copied analyzer's get-by-id.
TARGET_KEY=

# =============================================================================
# Service principal (used ONLY by the `spn-probe` subcommand)
# =============================================================================
# The spn-probe subcommand tests what role/scope a service principal needs to
# resolve a project-scoped analyzer by id and run :analyze on the TARGET
# resource. Leave these unset if you're only running the copy-bug repro.
#
# Create an SPN in the same tenant as your Foundry resources, then set:
#   SPN_TENANT_ID      the tenant of your Foundry resources
#   SPN_CLIENT_ID      the app registration / SPN client id
#   SPN_CLIENT_SECRET  a secret for that app (client credential flow)
#
# The probe uses these for the Entra bearer-token flow ONLY when
# spn-probe runs. run-all and every other subcommand still use your signed-in
# user via DefaultAzureCredential.
SPN_TENANT_ID=
SPN_CLIENT_ID=
SPN_CLIENT_SECRET=

# Free-form label recorded in spn_probe.md so you can eyeball which run
# tested which role assignment. Update this before each spn-probe run.
# Example: "Azure AI User at project sub-scope only"
SPN_ROLES_NOTE=

# Optional fallback analyzer id for spn-probe when you're not reusing a run
# that had `copy` already write target_analyzer_id into state.json. If you
# just want to probe an existing analyzer on the target (portal-created or
# previously copied), set this. `--analyzer-id` on the command line wins over
# this env var, which wins over state.json.
TARGET_ANALYZER_ID=
