API_VERSION=2025-11-01

# Source Foundry resource (where the analyzer is created first)
SOURCE_ENDPOINT=https://<source-resource-name>.services.ai.azure.com
SOURCE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<source-resource-name>
SOURCE_REGION=<azure-region>
SOURCE_AUTH_MODE=entra          # entra | key
SOURCE_KEY=

# Target Foundry resource (where the analyzer is copied to)
TARGET_ENDPOINT=https://<target-resource-name>.services.ai.azure.com
TARGET_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<target-resource-name>
TARGET_REGION=<azure-region>
TARGET_AUTH_MODE=entra
TARGET_KEY=

# Optional: override the completion / embedding models the harness requests.
# These must exist on BOTH resources (source and target) or analyzer creation
# will fail. Defaults are set in repro.py::_analyzer_body() if unset.
COMPLETION_MODEL=
EMBEDDING_MODEL=

# Analyzer naming — used as a prefix; a UTC timestamp is appended per run.
ANALYZER_BASE_NAME=cu_copy_repro

# --- Project-scoped mode (--mode project-scoped) -----------------------------
# Required only when running with --mode project-scoped. In that mode the
# harness skips create-source and instead copies from an existing
# portal-created (project-scoped) analyzer that already lives on SOURCE.
#
# SOURCE_ANALYZER_ID: the analyzer id as shown in the source's GET /analyzers
# list (e.g. "LSC_LP_Test1"). The harness will GET it on source to confirm
# it's ready, then copy it to TARGET.
#
# SOURCE_PROJECT_ID: optional. Purely informational for the report — the
# actual project scoping is defined by the portal-created analyzer itself.
SOURCE_ANALYZER_ID=
SOURCE_PROJECT_ID=

# Extra api-version used only during --mode project-scoped verify to probe
# the copied analyzer with both the stable and preview api-versions. This is
# how we distinguish "get-by-id is broken across api-versions" from
# "resolved on preview but not stable".
PREVIEW_API_VERSION=2026-06-01-preview
